; Engine configuration file.
; Jungle Tag - a Gorilla Tag inspired keyboard & mouse jungle tag game.

config_version=5

[application]

config/name="Jungle Tag"
config/description="Swing, climb and camouflage your way through the jungle in this gorilla tag game."
config/version="0.4.0"
config/build=9
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Game="*res://scripts/autoload/game_state.gd"
Net="*res://scripts/autoload/network.gd"
Sfx="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

rendering_device/fallback_to_opengl3=true
rendering_device/fallback_to_d3d12=true

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.9, 1)
textures/canvas_textures/default_texture_filter=1
